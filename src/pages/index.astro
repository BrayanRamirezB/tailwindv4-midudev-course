---
import Layout from '../layouts/Layout.astro'
import Check from '../icons/Check.astro'
import Github from '../icons/Github.astro'
import LinkedIn from '../icons/LinkedIn.astro'
import Mail from '../icons/Mail.astro'
---

<Layout>
  <main class='h-full bg-gradient-to-b from-black via-sky-950 to-gray-800'>
    <div class='flex flex-col mx-auto items-center justify-center max-w-xl'>
      <img
        src='/brbghibli.webp'
        alt='brbghibli'
        class='h-[600px] w-[600px] object-cover mt-10 mask-radial-at-center mask-radial-from-50% mask-radial-to-70%'
      />

      <div
        class='flex flex-row items-center justify-center gap-2 -mt-10 bg-black/50 backdrop-blur-md saturate-150 text-sky-400 text-xl font-medium border border-sky-500 rounded-full px-4 py-2'
      >
        <span>@BrayanRamirezB</span>

        <span
          class='size-5 bg-sky-400 rounded-full flex items-center justify-center'
          ><Check class='size-4 text-neutral-100' /></span
        >
      </div>

      <h1 class='text-4xl text-neutral-100 font-semibold mt-6'>
        Brayan Ramirez Benitez
      </h1>

      <section class='flex flex-row items-center justify-center mt-6 gap-2'>
        <a
          href='https://github.com/BrayanRamirezB'
          target='_blank'
          class='rounded-full size-12 bg-black flex items-center justify-center hover:scale-110 transition-transform duration-300'
          ><Github class='size-7' /></a
        >
        <a
          href='https://www.linkedin.com/in/brayanramirezbenitez/'
          target='_blank'
          class='rounded-full size-12 bg-neutral-100 flex items-center justify-center hover:scale-110 transition-transform duration-300'
          ><LinkedIn class='size-7' /></a
        >
        <a
          href='mailto:brayanramirezbenitez@gmail.com'
          target='_blank'
          class='rounded-full size-12 bg-blue-500 flex items-center justify-center hover:scale-110 transition-transform duration-300'
          ><Mail class='size-7' /></a
        >
      </section>

      <p class='mt-6 text-neutral-200 text-center text-pretty'>
        Soy un ingeniero en sistemas computacionales con pasión por construir y
        diseñar interfaces fáciles de usar.
      </p>
    </div>
  </main>
</Layout>
