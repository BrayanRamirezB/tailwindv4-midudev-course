---
import Layout from '../layouts/Layout.astro'
import Check from '../icons/Check.astro'
import Github from '../icons/Github.astro'
import LinkedIn from '../icons/LinkedIn.astro'
import Mail from '../icons/Mail.astro'
import ReactIcon from '../icons/React.astro'
import CssIcon from '../icons/Css.astro'
import HtmlIcon from '../icons/HtmlIcon.astro'
import NodeIcon from '../icons/Node.astro'
---

<Layout>
  <main class='relative bg-gradient-to-b from-black via-sky-950 to-gray-800'>
    <div class='flex flex-col mx-auto items-center justify-center max-w-xl'>
      <img
        src='/brbghibli.webp'
        alt='brbghibli'
        class='h-[450px] w-[450px] object-cover mt-10 mask-radial-at-center mask-radial-from-50% mask-radial-to-70%'
      />

      <div
        class='flex flex-row items-center justify-center gap-2 -mt-10 bg-black/50 backdrop-blur-md saturate-150 text-sky-400 text-xl font-medium border border-sky-500 rounded-full px-4 py-2'
      >
        <span>@BrayanRamirezB</span>

        <span
          class='size-5 bg-sky-400 rounded-full flex items-center justify-center'
          ><Check class='size-4 text-neutral-100' /></span
        >
      </div>

      <h1 class='text-4xl text-neutral-100 font-semibold mt-6'>
        Brayan Ramirez Benitez
      </h1>

      <section class='flex flex-row items-center justify-center mt-6 gap-2'>
        <a
          href='https://github.com/BrayanRamirezB'
          target='_blank'
          class='rounded-full size-12 bg-black flex items-center justify-center hover:scale-110 transition-transform duration-300'
          ><Github class='size-7' /></a
        >
        <a
          href='https://www.linkedin.com/in/brayanramirezbenitez/'
          target='_blank'
          class='rounded-full size-12 bg-neutral-100 flex items-center justify-center hover:scale-110 transition-transform duration-300'
          ><LinkedIn class='size-7' /></a
        >
        <a
          href='mailto:brayanramirezbenitez@gmail.com'
          target='_blank'
          class='rounded-full size-12 bg-blue-500 flex items-center justify-center hover:scale-110 transition-transform duration-300'
          ><Mail class='size-7' /></a
        >
      </section>

      <p class='mt-6 text-neutral-200 text-center text-pretty'>
        Soy un ingeniero en sistemas computacionales con pasión por construir y
        diseñar interfaces fáciles de usar.
      </p>

      <section
        class='grid grid-cols-3 grid-rows-2 gap-3 mt-6 mb-20 w-full h-full text-neutral-100'
      >
        <div
          class='relative overflow-hidden bg-gradient-to-br from-cyan-700 to-cyan-500 col-span-2 p-7 min-h-[180px] border border-cyan-600 rounded-4xl hover:scale-105 hover:saturate-150 transition duration-200 cursor-pointer group'
        >
          <span
            class='absolute top-2 text-sm left-4 border px-2 py-0.5 rounded-full'
            >Texto 1</span
          >
          <span class='absolute bottom-2 left-4 font-bold text-2xl'>
            React.js
          </span>
          <span>
            <ReactIcon
              class='absolute -bottom-6 -right-4 size-30 group-hover:-rotate-12 group-hover:scale-125 transition-transform duration-200'
            />
          </span>
        </div>
        <div
          class='relative overflow-hidden bg-gradient-to-br from-orange-500 to-orange-200 p-7 min-h-[180px] border border-orange-600 rounded-4xl hover:scale-105 hover:saturate-150 transition duration-200 cursor-pointer group'
        >
          <span
            class='absolute top-2 text-sm left-4 border px-2 py-0.5 rounded-full'
            >Texto 2</span
          >
          <span class='absolute bottom-2 left-4 font-bold text-2xl'>
            HTML
          </span>
          <span>
            <HtmlIcon
              class='absolute -bottom-6 -right-4 size-30 -rotate-6 group-hover:-rotate-12 group-hover:scale-125 transition-transform duration-200'
            />
          </span>
        </div>

        <div
          class='relative overflow-hidden bg-gradient-to-br from-purple-700 to-purple-400 p-7 min-h-[180px] border border-purple-600 rounded-4xl hover:scale-105 hover:saturate-150 transition duration-200 cursor-pointer group'
        >
          <span
            class='absolute top-2 text-sm left-4 border px-2 py-0.5 rounded-full'
            >Texto 3</span
          >
          <span class='absolute bottom-2 left-4 font-bold text-2xl'>CSS</span>
          <span>
            <CssIcon
              class='absolute -bottom-6 -right-4 size-30 -rotate-6 group-hover:-rotate-12 group-hover:scale-125 transition-transform duration-200'
            />
          </span>
        </div>
        <div
          class='relative overflow-hidden bg-gradient-to-br from-[#215732] via-[#3C873A] to-[#8CC84B] col-span-2 p-7 min-h-[180px] border border-emerald-800 rounded-4xl hover:scale-105 hover:saturate-150 transition duration-200 cursor-pointer group'
        >
          <span
            class='absolute top-2 text-sm left-4 border px-2 py-0.5 rounded-full'
            >Texto 4</span
          >
          <span class='absolute bottom-2 left-4 font-bold text-2xl'>
            Node.js
          </span>
          <span>
            <NodeIcon
              class='absolute -bottom-6 -right-4 size-30 -rotate-6 group-hover:-rotate-12 group-hover:scale-125 transition-transform duration-200'
            />
          </span>
        </div>
      </section>
    </div>
  </main>
</Layout>
