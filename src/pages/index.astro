---
import Layout from '../layouts/Layout.astro'
import Check from '../icons/Check.astro'
---

<Layout>
  <main class='h-full bg-gradient-to-b from-black via-sky-950 to-gray-800'>
    <div class='flex flex-col mx-auto items-center justify-center'>
      <div class='rounded-full overflow-hidden size-[400px] mt-20'>
        <img
          src='/brbghibli.webp'
          alt='brbghibli'
          class='w-full h-full object-cover'
        />
      </div>

      <div
        class='flex flex-row items-center justify-center gap-2 -mt-6 bg-black/50 backdrop-blur-md saturate-150 text-sky-400 text-xl font-medium border border-sky-500 rounded-full px-4 py-2'
      >
        <span>@BrayanRamirezB</span>

        <span
          class='size-5 bg-sky-400 rounded-full flex items-center justify-center'
          ><Check class='size-4 text-neutral-100' /></span
        >
      </div>

      <h1 class='text-4xl text-neutral-100 font-semibold mt-6'>
        Brayan Ramirez Benitez
      </h1>

      <div class='flex flex-row items-center justify-center mt-10'></div>
    </div>
  </main>
</Layout>
